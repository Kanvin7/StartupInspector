<Window x:Class="StartupInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartupInspector — 开机自启检测" Height="800" Width="1260" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#080B0F" Foreground="#D7F7FF"
        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="Panel" Color="#0D1218" />
        <SolidColorBrush x:Key="PanelSoft" Color="#111820" />
        <SolidColorBrush x:Key="Line" Color="#3A22D3EE" />
        <SolidColorBrush x:Key="LineSoft" Color="#2622D3EE" />
        <SolidColorBrush x:Key="Text" Color="#D7F7FF" />
        <SolidColorBrush x:Key="Muted" Color="#6B8F9C" />
        <SolidColorBrush x:Key="Accent" Color="#22D3EE" />
        <SolidColorBrush x:Key="AccentDim" Color="#2422D3EE" />
        <SolidColorBrush x:Key="Hover" Color="#1222D3EE" />

        <!-- 覆盖系统色,让下拉弹层 / 右键菜单 / 滚动条等默认模板跟着变深 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0D1218" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D7F7FF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0D1218" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#D7F7FF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2422D3EE" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2422D3EE" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />

        <!-- 细滚动条:默认的浅色滚动条在近黑底上很突兀 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3A22D3EE" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimary" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Foreground" Value="#06252B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Accent}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#67E8F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏筛选:单选按钮做成描边列表项 -->
        <Style x:Key="RailRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,7,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,7,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource PanelSoft}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource PanelSoft}" BorderBrush="{StaticResource LineSoft}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                <Path Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                      Fill="{StaticResource Muted}" Data="M0,0 L4,4 L8,0 Z" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Margin="10,0,4,0" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1A22D3EE" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0,10,8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDim}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="Foreground" Value="#5E7C88" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左栏:读数与筛选 ================= -->
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="18,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="STARTUP INSPECTOR" Foreground="{StaticResource Accent}" FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ElevationText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="总条目" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock x:Name="TotalText" Text="0" HorizontalAlignment="Right" FontSize="12" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineSoft}" />
                    <Grid Margin="0,6,0,6">
                        <TextBlock Text="已启用" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock x:Name="EnabledText" Text="0" HorizontalAlignment="Right" FontSize="12" Foreground="#7DD3A0" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineSoft}" />
                    <Grid Margin="0,6,0,6">
                        <TextBlock Text="已停用" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock x:Name="DisabledText" Text="0" HorizontalAlignment="Right" FontSize="12" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineSoft}" />
                    <Grid Margin="0,6,0,6">
                        <TextBlock Text="最慢一项" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock x:Name="SlowestText" Text="—" HorizontalAlignment="Right" FontSize="12" Foreground="#FB7185" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineSoft}" />
                    <TextBlock x:Name="ScanTimeText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                    <TextBlock x:Name="WarnText" Foreground="#FBBF24" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,22,0,0">
                    <TextBlock Text="筛选" Foreground="{StaticResource Muted}" FontSize="11" />
                    <RadioButton x:Name="AllFilter" Style="{StaticResource RailRadio}" GroupName="StateFilter"
                                 IsChecked="True" Checked="StateFilter_Checked">
                        <Grid>
                            <TextBlock Text="全部" />
                            <TextBlock x:Name="AllCountText" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="OnFilter" Style="{StaticResource RailRadio}" GroupName="StateFilter" Checked="StateFilter_Checked">
                        <Grid>
                            <TextBlock Text="仅已启用" />
                            <TextBlock x:Name="OnCountText" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="OffFilter" Style="{StaticResource RailRadio}" GroupName="StateFilter" Checked="StateFilter_Checked">
                        <Grid>
                            <TextBlock Text="仅已停用" />
                            <TextBlock x:Name="OffCountText" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                        </Grid>
                    </RadioButton>
                    <ToggleButton x:Name="SortByImpactToggle" Style="{StaticResource RailToggle}"
                                  Content="按耗时排序" Checked="SortByImpact_Changed" Unchecked="SortByImpact_Changed" />
                </StackPanel>

                <Button Grid.Row="4" x:Name="ElevateButton" Style="{StaticResource NeonButton}" Margin="0"
                        Content="以管理员身份重启" Click="Elevate_Click" />
            </Grid>
        </Border>

        <!-- ================= 主区:工具条 / 表格 / 命令行 ================= -->
        <Grid Grid.Column="1" Margin="18,16,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <Button x:Name="ScanButton" DockPanel.Dock="Left" Style="{StaticResource NeonPrimary}"
                        Content="重新扫描" Click="ScanButton_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NeonButton}" Content="导出 CSV" Click="ExportCsv_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NeonButton}" Content="导出 JSON" Click="ExportJson_Click" />
                <Button x:Name="UndoButton" DockPanel.Dock="Left" Style="{StaticResource NeonButton}"
                        Content="撤销删除" Click="Undo_Click" />
                <ComboBox x:Name="SourceFilter" DockPanel.Dock="Right" Width="170" SelectionChanged="Filter_Changed" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,12,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="260" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" />
                    <TextBlock Text="grep 名称 / 发布者 / 路径" Foreground="#4E6B76" Margin="10,0,0,0" FontSize="12"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Grid.Column="1" x:Name="FilterSummaryText" Foreground="{StaticResource Muted}" FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>

            <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Extended"
                      SelectionChanged="Grid_SelectionChanged"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="EnableMenuItem" Header="启用" Click="Enable_Click" ToolTipService.ShowOnDisabled="True" />
                        <MenuItem x:Name="DisableMenuItem" Header="停用" Click="Disable_Click" ToolTipService.ShowOnDisabled="True" />
                        <MenuItem Header="删除" Click="Delete_Click" />
                        <Separator />
                        <MenuItem Header="打开文件所在位置" Click="OpenLocation_Click" />
                        <MenuItem Header="复制命令行" Click="CopyCommand_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="名称" Width="1.7*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,9,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FBBF24"
                                               Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="可执行文件已不存在"
                                               Visibility="{Binding IsOrphaned, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="来源" Width="1.5*" SortMemberPath="SourceText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceText}" Foreground="{Binding SourceBrush}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="状态" Width="86" SortMemberPath="StatusText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="耗时" Width="84" SortMemberPath="ImpactMilliseconds">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ImpactText}" Foreground="{Binding ImpactBrush}" FontSize="11"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="1.2*" />
                    <DataGridTextColumn Header="可执行文件" Binding="{Binding ExecutablePath}" Width="2.2*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 面板内的提示 / 确认条,替代系统弹窗 -->
            <Border Grid.Row="3" x:Name="NoticeBar" Visibility="Collapsed" Margin="0,10,0,0"
                    Background="{StaticResource PanelSoft}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="4" Padding="11,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoticeGlyph" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,9,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
                        <TextBlock x:Name="NoticeDetail" TextWrapping="Wrap" MaxHeight="34" FontSize="11"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="NoticeYes" Content="是" Style="{StaticResource NeonPrimary}"
                                Visibility="Collapsed" Click="NoticeYes_Click" />
                        <Button x:Name="NoticeNo" Content="否" Style="{StaticResource NeonButton}"
                                Visibility="Collapsed" Click="NoticeNo_Click" />
                        <Button x:Name="NoticeClose" Content="关闭" Style="{StaticResource NeonButton}" Margin="0"
                                Click="NoticeClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <Border Height="1" Background="{StaticResource Line}" />
                <TextBlock Margin="0,9,0,0" FontSize="11" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" Text="选中一行查看完整命令行" x:Name="DetailText" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

